{% extends 'base.html.twig' %}

{% block title %}
  Votre projet — BRASS’AIR
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('assets/css/brassair-contact.css') }}" />
{% endblock %}

{% block body %}
  <div class="d-none d-lg-block">
    {% include 'navbar_visitors_lg.html.twig' %}
  </div>
  <div class="d-block d-lg-none">
    {% include 'navbar_visitors_md.html.twig' %}
  </div>

  <main class="brassair-contact">
    <div class="container py-5">
      <header class="bc-intro">
        <p class="bc-eyebrow">VOTRE PROJET DE VENTILATION</p>
        <h1>Parlez-nous de votre projet</h1>
        <p class="bc-lead">Un bâtiment à équiper, un espace à rendre plus confortable ? Décrivez-nous votre besoin : BRASS’AIR vous accompagne dans le choix d’une solution adaptée à vos usages.</p>
      </header>

      <div class="bc-layout">
        <section class="bc-form-card" aria-labelledby="bc-form-title">
          <div class="bc-form-heading">
            <span class="bc-accent" aria-hidden="true"></span>
            <h2 id="bc-form-title">Votre besoin, en quelques mots</h2>
            <p>Présentez votre espace et les améliorations souhaitées. Vous pouvez également joindre vos plans ou documents techniques.</p>
          </div>
          <div class="bc-form">{{ include('contact_form/_form.html.twig', { button_label: 'Envoyer ma demande' }) }}</div>
        </section>

        <aside class="bc-aside" aria-label="Préparer votre demande">
          <figure class="bc-photo-card">
            <img src="{{ asset('images/contact/ventilateur-cinepalmes.webp') }}" alt="Ventilateur de grand diamètre installé sous la charpente du Cinépalmes de Sainte-Marie" width="1050" height="1400" class="bc-photo" decoding="async" />
            <figcaption>
              <span>Une solution intégrée au bâtiment</span>Cinépalmes · Sainte-Marie
            </figcaption>
          </figure>
          <div class="bc-help">
            <h2>Pour mieux comprendre votre projet</h2>
            <p>Si vous les connaissez, précisez :</p>
            <ul>
              <li>Le lieu et l’activité du bâtiment</li>
              <li>La surface et la hauteur sous plafond</li>
              <li>Les zones concernées et le confort recherché</li>
            </ul>
            <p class="bc-help-note">Vous n’avez pas encore tous ces éléments ? Décrivez simplement votre besoin pour commencer l’échange.</p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <div class="d-none d-lg-block">
    {% include 'footer.html.twig' %}
  </div>
  <div class="d-block d-lg-none">
    {% include 'footer_md.html.twig' %}
  </div>
{% endblock %}
