          </ul>

          <a href="{{ asset('pdfs/produits/DOC_FLOWER_FAN.pdf') }}" class="brassair-download" download aria-label="Télécharger la fiche PDF FF4000"><i class="fa-regular fa-file-pdf" aria-hidden="true"></i> Télécharger le PDF</a>
