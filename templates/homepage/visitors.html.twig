{% extends 'base.html.twig' %}
{% block title %}
  BRASS’AIR — Brassage d’air professionnel à La Réunion
{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    /* Variante claire du hero, limitée à cette page. */
    .brassair-hero.brassair-hero-light {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
      width: calc(100% - 3rem);
      max-width: 1240px;
      margin: 2rem auto 3rem;
      padding: 0;
      background: #fff;
      color: #23313b;
    }
    .brassair-hero-light .brassair-hero-copy {
      padding: 1.5rem 0;
    }
    .brassair-hero-light h1 {
      max-width: 19ch;
      margin: 0;
      font-size: clamp(2rem, 3.4vw, 3.4rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.025em;
      color: #243c48;
      overflow-wrap: break-word;
    }
    .brassair-hero-light .brassair-hero-copy > p {
      max-width: 49ch;
      margin: 1.5rem 0 2rem;
      font-size: 1.1rem;
      line-height: 1.8;
      color: #53636b;
    }
    .brassair-hero-light .brassair-hero-photo {
      display: block;
      width: 100%;
      height: auto;
      max-height: 640px;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      object-position: 50% 35%;
      border-radius: 18px;
    }
    .brassair-hero-light .brassair-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
    }
    .brassair-hero-light .btn-contact {
      background: #197935;
      color: #fff;
      border-radius: 6px;
      box-shadow: none;
    }
    .brassair-hero-light .btn-contact:hover {
      background: #12602a;
    }
    .brassair-hero-light .btn-hero-section {
      background: transparent;
      border: 1px solid #cbd5ce;
      border-radius: 6px;
      color: #245734;
      box-shadow: none;
    }
    .brassair-hero-light .btn-hero-section:hover {
      background: #f1f6f2;
    }
    .brassair-hero-light .brassair-actions a:focus-visible {
      outline: 3px solid #264b9a;
      outline-offset: 4px;
    }
    @media (max-width: 767px) {
      .brassair-hero.brassair-hero-light {
        grid-template-columns: minmax(0, 1fr);
        width: calc(100% - 2rem);
        gap: 1.5rem;
        margin: 1rem auto 2rem;
      }
      .brassair-hero-light .brassair-hero-copy {
        grid-row: 1;
        padding: 0.5rem 0 0;
      }
      .brassair-hero-light h1 {
        max-width: none;
        font-size: clamp(1.9rem, 7vw, 2.5rem);
      }
      .brassair-hero-light .brassair-hero-photo {
        grid-row: 2;
        max-height: none;
        height: auto;
        aspect-ratio: 3 / 4;
        border-radius: 12px;
      }
      .brassair-hero-light .brassair-actions a {
        width: 100%;
        text-align: center;
      }
    }
  </style>
{% endblock %}
{% block body %}
  <div class="d-none d-lg-block">
    {% include 'navbar_visitors_lg.html.twig' %}
  </div>
  <div class="d-block d-lg-none">
    {% include 'navbar_visitors_md.html.twig' %}
  </div>
  <main>
    <section class="brassair-hero brassair-hero-light">
      <div class="brassair-hero-copy">
        <h1>{{ homepage.hero1|default('BRASS’AIR, spécialiste du brassage d’air professionnel') }} {{ homepage.hero1Part2|default('à La Réunion') }}</h1><p>{{ homepage.hero2|default('Ancrée à La Réunion, BRASS’AIR déploie ses solutions de ventilation et de brassage d’air professionnel dans tout l’Océan Indien.') }}</p>
        <div class="brassair-actions">
          <a class="btn-contact" href="{{ path('app_contact_form_new') }}">DEMANDER UNE ÉTUDE</a><a class="btn-hero-section" href="{{ product_offer ? path('app_product_offer_visitors', { slug: product_offer.slug }) : path('app_product_offer_index_visitors') }}">ACTUALITÉS BRASS’AIR</a>
        </div>
      </div><img class="brassair-hero-photo" src="{{ asset(homepage.mainImage|default('images/homepage/mygym-saint-benoit.jpg')) }}" alt="Réalisation BRASS’AIR de brassage d’air professionnel" fetchpriority="high" />
    </section>
    <section class="container py-5">
      <h2 class="text-center">{{ homepage.titleSection2Big|default('NOS SOLUTIONS DE VENTILATION') }}</h2><p class="text-center lead">{{ homepage.titleSection2Small|default('Des solutions adaptées à vos bâtiments et à vos activités') }}</p>
      <div class="row g-4 mt-3">
        {% set sectors = [{ label: 'Industrie', route: 'app_application_industrie_show', image: 'INDUSTRIE_PHOTO_3.jpg', text: 'Industrie, entrepôts, logistique, ateliers et stockage.' }, { label: 'Bien-être animal', route: 'app_application_animal_show', image: 'BIEN_ÊTRE_ANIMAL_PHOTO_4.jpg', text: 'Solutions adaptées aux bâtiments d’élevage.' }, { label: 'Espaces commerciaux', route: 'app_application_commercial_show', image: 'COMMERCIAL_PHOTO_1.jpg', text: 'Commerces, grandes surfaces et concessions automobiles.' }, { label: 'Sport & Culture', route: 'app_application_sport_show', image: '5-0m-mygym360-st-jo-66baeb9be39d7097578670.jpg', text: 'Salles de sport, fitness, gymnases, cinémas et équipements culturels.' }] %}
        {% for sector in sectors %}
          <article class="col-md-6">
            <a class="brassair-sector" href="{{ path(sector.route) }}"><img loading="lazy" src="{{ asset('images/produits/' ~ sector.image) }}" alt="{{ sector.label }}" /><h3 class="h4 mt-3">{{ sector.label }} →</h3></a><p>{{ sector.text }}</p>
          </article>
        {% endfor %}
      </div>
    </section>
    <section class="brassair-about" aria-labelledby="about-title">
      <div class="container brassair-about-layout">
        <div class="brassair-about-heading">
          <p class="brassair-about-eyebrow">Notre expertise</p>
          <h2 id="about-title">BRASS’AIR</h2>
          <p class="brassair-about-location">À La Réunion et dans l’Océan Indien</p>
        </div>

        <div class="brassair-about-text">
          <p>{{ homepage.aboutText1|default('')|nl2br }}</p>
          <p>{{ homepage.aboutText2|default('')|nl2br }}</p>
        </div>
      </div>
    </section>
    <section class="container py-5">
      <h2 class="text-center mb-4">{{ homepage.titleSection3|default('NOS RÉALISATIONS') }}</h2><div class="row g-4">
        <figure class="col-md-4">
          <img class="brassair-realisation" loading="lazy" src="{{ asset('images/homepage/mygym-saint-benoit.jpg') }}" alt="Ventilateur chez MYGYM Saint-Benoît" /><figcaption class="mt-2">Salle de sport — MYGYM Saint-Benoît</figcaption>
        </figure>
        <figure class="col-md-4">
          <div class="ratio ratio-16x9">
            <video controls preload="none" poster="{{ asset('images/produits/4-0m-egl-ass-de-dieu-st-benoit-overlay-30-66bb0605f1f26088266479.jpg') }}">
              <source src="{{ asset('videos/video-eglise-st-benoit-brassair.mp4') }}" type="video/mp4" />
            </video>
          </div>
          <figcaption class="mt-2">Église — Saint-Benoît — installation de 2019</figcaption>
        </figure>
        <figure class="col-md-4">
          <div class="ratio ratio-16x9">
            <video controls preload="none">
              <source src="{{ asset('videos/video-mygym-le-port-brassair.mp4') }}" type="video/mp4" />
            </video>
          </div>
          <figcaption class="mt-2">Salle de sport — MYGYM Le Port</figcaption>
        </figure>
      </div>
    </section>
  </main>
  {% include 'contact_bar.html.twig' %}
  <div class="d-none d-lg-block">
    {% include 'footer.html.twig' %}
  </div>
  <div class="d-block d-lg-none">
    {% include 'footer_md.html.twig' %}
  </div>
{% endblock %}
